{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{name}}",
  "image": [
    "{{image}}"
  ],
  "description": "{{description}}",
  "sku": "{{sku}}",
  "brand": {
    "@type": "Brand",
    "name": "{{brand}}"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{url}}",
    "priceCurrency": "{{priceCurrency}}",
    "price": "{{price}}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock"
  }
}
